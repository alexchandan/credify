#!/usr/bin/env sh

COMMIT_MSG=$(cat "$1")
SUBJECT=$(printf "%s" "$COMMIT_MSG" | head -n1)

# ---- Configuration ----

TYPES="feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert"
MAX_LENGTH=100

# ---- Message Description ----

# feat     - Add a new feature or functionality.
# fix      - Fix a bug or incorrect behavior.
# docs     - Update documentation only (README, comments, API docs, etc.).
# style    - Make formatting or styling changes without affecting functionality (whitespace, indentation, prettier, CSS formatting).
# refactor - Restructure or clean up code without changing its behavior.
# perf     - Improve performance without changing functionality.
# test     - Add, update, or fix tests.
# build    - Change the build system, dependencies, or package management.
# ci       - Update CI/CD configuration or automation workflows.
# chore    - Perform maintenance tasks that don't affect application code or tests (configs, tooling, housekeeping).
# revert   - Revert a previous commit.


# ---- Validation ----

# Format:
# type(scope)!: subject
# Examples:
#   feat: add authentication
#   fix(api): resolve token validation
#   refactor(user-profile)!: remove legacy endpoints

if ! printf "%s" "$SUBJECT" | grep -Eq "^($TYPES)(\([a-z0-9-]+\))?!?: .+$"; then
    echo "❌ Invalid commit message."
    echo
    echo "Expected format:"
    echo "  <type>(optional-scope): <description>"
    echo
    echo "Valid types:"
    echo "  feat, fix, docs, style, refactor, perf,"
    echo "  test, build, ci, chore, revert"
    echo
    echo "Examples:"
    echo "  feat: add authentication"
    echo "  fix(api): resolve token validation"
    echo "  refactor(user-profile): simplify state management"
    echo "  feat(auth)!: remove legacy login flow"
    exit 1
fi

# ---- Subject length ----

if [ ${#SUBJECT} -gt "$MAX_LENGTH" ]; then
    echo "❌ Commit subject is too long."
    echo "Current length : ${#SUBJECT}"
    echo "Maximum length : $MAX_LENGTH"
    exit 1
fi

# ---- Subject must not end with '.' ----

if printf "%s" "$SUBJECT" | grep -Eq "\.$"; then
    echo "❌ Commit subject must not end with a period."
    exit 1
fi

# ---- Commit type must be lowercase ----

if printf "%s" "$SUBJECT" | grep -Eq "^[A-Z]"; then
    echo "❌ Commit type must be lowercase."
    echo
    echo "Bad : FEAT: add login"
    echo "Good: feat: add login"
    exit 1
fi

# ---- Subject should start with lowercase (recommended) ----

DESCRIPTION=$(printf "%s" "$SUBJECT" | sed -E 's/^[^:]+: //')

FIRST_CHAR=$(printf "%s" "$DESCRIPTION" | cut -c1)

if printf "%s" "$FIRST_CHAR" | grep -Eq "[A-Z]"; then
    echo "❌ Commit description should start with a lowercase letter."
    echo
    echo "Bad : feat: Add login"
    echo "Good: feat: add login"
    exit 1
fi

# ---- Success ----

echo "✅ Commit message looks good."

# ---- Automatic semantic versioning ----

PENDING_VERSION_FILE=$(git rev-parse --git-path CREDIFY_AUTO_VERSION_PENDING)
rm -f "$PENDING_VERSION_FILE"

if [ "${SKIP_AUTO_VERSION:-0}" = "1" ]; then
    echo "⏭️  Automatic versioning skipped."
    exit 0
fi

BUMP_TYPE=$(node scripts/increment-version.mjs detect "$1") || exit 1

if [ "$BUMP_TYPE" = "none" ]; then
    echo "ℹ️  This commit does not require a version bump."
    exit 0
fi

if git diff --cached --unified=0 -- package.json | grep -Eq '^\+[[:space:]]*"version":'; then
    echo "ℹ️  Using the manually staged project version."
    exit 0
fi

PACKAGE_FILES="package.json client/package.json server/package.json"

for file in $PACKAGE_FILES; do
    if [ -f "$file" ] && ! git diff --quiet -- "$file"; then
        echo "❌ Cannot automatically bump project version."
        echo "Unstaged changes detected in $file. Stage or stash them, then try again."
        exit 1
    fi
done

node scripts/increment-version.mjs "$BUMP_TYPE"

for file in $PACKAGE_FILES; do
    if [ -f "$file" ]; then
        git add "$file"
    fi
done

printf "%s\n" "$BUMP_TYPE" > "$PENDING_VERSION_FILE"
echo "✅ Prepared and staged the $BUMP_TYPE version bump."
exit 0
