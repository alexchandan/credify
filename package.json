{
  "name": "Credify",
  "version": "1.3.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "test": "pnpm --dir server test",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "pnpm -r type-check",
    "version:check": "node scripts/increment-version.mjs check",
    "version:increment": "node scripts/increment-version.mjs",
    "verify": "pnpm lint && pnpm type-check && pnpm test && pnpm format:check && pnpm build"
  },
  "lint-staged": {
    "client/**/*.{ts,tsx,js,jsx}": [
      "pnpm --dir client lint:fix",
      "prettier --write"
    ],
    "server/**/*.ts": [
      "pnpm --dir server lint:fix",
      "prettier --write"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.9.0 <12"
  },
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.1.1",
    "eslint": "^10.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.4",
    "prettier-plugin-tailwindcss": "^0.8.0"
  }
}
